# Touchscreen gestures (read by ~/.local/bin/tablet-mode, run by lisgd).
# Format: fingers,direction,edge,distance,when,command
#   direction: LR RL UD DU (left->right, right->left, up->down, down->up)
#              diagonals ULDR URDL DLUR DRUL
#   edge:      T B L R (TL TR BL BR corners) = must start there, * = anywhere, N = not at an edge
#   distance:  S M L = short/medium/long swipe, * = any
#   when:      R = on release

# Always on, laptop or tablet: the same three-finger swipes as the touchpad
# (~/.config/hypr/input.lua).
gestures=(
  # Left / right: next / previous workspace
  "3,RL,*,*,R,hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
  "3,LR,*,*,R,hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'"
  "4,RL,*,*,R,hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
  "4,LR,*,*,R,hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'"
  # Up: open apps overview (SUPER+TAB)
  "3,DU,*,*,R,omarchy-shell shell toggle daa.overview"
  # Down: hide scratchpads / dropdowns (and the overview)
  "3,UD,*,*,R,omarchy-shell -q shell hide daa.overview; $HOME/.local/bin/tablet-mode hide-scratchpads"
  # Four fingers up: app grid (SUPER+R). Down: close the focused window.
  "4,DU,*,*,R,omarchy-shell shell toggle daa.launcher"
  "4,UD,*,*,R,hyprctl dispatch 'hl.dsp.window.close()'"
  "5,UD,*,*,R,$HOME/.local/bin/projector show"
  "5,DU,*,*,R,$HOME/.local/bin/projector show"
)

# Tablet mode only: one-finger edge swipes.
tablet_gestures=(
  # Swipe down from the top edge: tablet menu (keyboard, rotate, apps, exit)
  "1,UD,T,*,R,omarchy menu summon tablet"
  # Swipe up from the bottom edge: show / hide the on-screen keyboard
  "1,DU,B,*,R,$HOME/.local/bin/tablet-mode keyboard"
  # Swipe in from the left edge: app grid
  "1,LR,L,*,R,omarchy-shell shell toggle daa.launcher"
  # Swipe in from the right edge: close the focused window
  "1,RL,R,M,R,hyprctl dispatch 'hl.dsp.window.close()'"
  # Diagonal swipe in from any corner toward the middle (~3 in): open apps overview
  "1,ULDR,TL,*,R,omarchy-shell shell toggle daa.overview"
  "1,URDL,TR,*,R,omarchy-shell shell toggle daa.overview"
  "1,DLUR,BL,*,R,omarchy-shell shell toggle daa.overview"
  "1,DRUL,BR,*,R,omarchy-shell shell toggle daa.overview"
)
