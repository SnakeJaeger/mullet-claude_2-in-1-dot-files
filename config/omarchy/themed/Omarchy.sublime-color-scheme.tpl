{
  // Sublime Text colour scheme generated from the current Omarchy theme
  // (same mapping as zed.json.tpl). Rendered into
  // ~/.local/state/omarchy/current/theme/ on every theme switch and linked as
  // ~/.config/sublime-text/Packages/User/Omarchy.sublime-color-scheme. The UI
  // theme is Adaptive, which takes its colours from this scheme.
  "name": "Omarchy",
  "author": "Generated from the current Omarchy theme",
  "variables": {},
  "globals": {
    "background": "{{ background }}",
    "foreground": "{{ foreground }}",
    "caret": "{{ accent }}",
    "block_caret": "{{ accent }}",
    "line_highlight": "{{ lighter_background }}",
    "selection": "{{ selection }}",
    "selection_border": "{{ selection }}",
    "inactive_selection": "{{ lighter_background }}",
    "misspelling": "{{ red }}",
    "gutter": "{{ background }}",
    "gutter_foreground": "{{ muted }}",
    "gutter_foreground_highlight": "{{ foreground }}",
    "invisibles": "{{ muted }}",
    "guide": "{{ lighter_background }}",
    "active_guide": "{{ muted }}",
    "stack_guide": "{{ lighter_background }}",
    "rulers": "{{ lighter_background }}",
    "highlight": "{{ accent }}",
    "find_highlight": "{{ yellow }}",
    "find_highlight_foreground": "{{ darker_background }}",
    "brackets_foreground": "{{ accent }}",
    "brackets_options": "underline",
    "bracket_contents_foreground": "{{ accent }}",
    "bracket_contents_options": "underline",
    "tags_options": "stippled_underline",
    "accent": "{{ accent }}",
    "line_diff_added": "{{ green }}",
    "line_diff_modified": "{{ yellow }}",
    "line_diff_deleted": "{{ red }}",
    "shadow": "{{ darker_background }}"
  },
  "rules": [
    { "name": "Comment", "scope": "comment, punctuation.definition.comment", "foreground": "{{ dark_foreground }}", "font_style": "italic" },
    { "name": "Keyword", "scope": "keyword, storage.type, storage.modifier", "foreground": "{{ bright_magenta }}" },
    { "name": "Operator", "scope": "keyword.operator", "foreground": "{{ bright_cyan }}" },
    { "name": "Punctuation", "scope": "punctuation", "foreground": "{{ light_foreground }}" },
    { "name": "String", "scope": "string", "foreground": "{{ green }}" },
    { "name": "String escape", "scope": "constant.character.escape, string.regexp", "foreground": "{{ bright_cyan }}" },
    { "name": "Number", "scope": "constant.numeric", "foreground": "{{ bright_yellow }}" },
    { "name": "Constant", "scope": "constant.language, constant.other, support.constant", "foreground": "{{ bright_yellow }}" },
    { "name": "Function", "scope": "entity.name.function, support.function, variable.function", "foreground": "{{ blue }}" },
    { "name": "Type", "scope": "entity.name.type, entity.name.class, support.type, support.class, storage.type.class", "foreground": "{{ bright_cyan }}" },
    { "name": "Variable", "scope": "variable", "foreground": "{{ bright_foreground }}" },
    { "name": "Special variable", "scope": "variable.language", "foreground": "{{ red }}" },
    { "name": "Parameter", "scope": "variable.parameter", "foreground": "{{ yellow }}" },
    { "name": "Property", "scope": "variable.other.member, meta.property-name, support.type.property-name, entity.name.tag.yaml, meta.mapping.key string", "foreground": "{{ green }}" },
    { "name": "Attribute", "scope": "entity.other.attribute-name", "foreground": "{{ yellow }}" },
    { "name": "Tag", "scope": "entity.name.tag", "foreground": "{{ red }}" },
    { "name": "Namespace", "scope": "entity.name.namespace, entity.name.module", "foreground": "{{ bright_cyan }}" },
    { "name": "Heading", "scope": "markup.heading, entity.name.section", "foreground": "{{ blue }}", "font_style": "bold" },
    { "name": "Bold", "scope": "markup.bold", "font_style": "bold" },
    { "name": "Italic", "scope": "markup.italic", "font_style": "italic" },
    { "name": "Link", "scope": "markup.underline.link", "foreground": "{{ accent }}" },
    { "name": "Inserted", "scope": "markup.inserted", "foreground": "{{ green }}" },
    { "name": "Changed", "scope": "markup.changed", "foreground": "{{ yellow }}" },
    { "name": "Deleted", "scope": "markup.deleted", "foreground": "{{ red }}" },
    { "name": "Invalid", "scope": "invalid", "foreground": "{{ bright_foreground }}", "background": "{{ red }}" }
  ]
}
