{
  // Extend the Quickshell Omarchy menu with JSONC.
  //
  // IDs are object keys. The parent is inferred from the dotted id, so
  // "personal.notes" appears under "personal", and "personal" appears on the
  // root menu. Reuse an existing id to override/extend it.
  //
  // Fields:
  //   icon        Nerd Font glyph shown in the icon column.
  //   label       Visible row title.
  //   action      Shell command to run. If omitted, the row is a submenu.
  //   target      Existing submenu id to open. Use for links/aliases.
  //   provider    Runtime provider function/command returning JSON rows.
  //   aliases     alternate `omarchy menu summon <name>` routes; also searchable.
  //   description Optional subtitle and extra search text.
  //   when        Shell condition; hide row when it fails.
  //   checked     Shell condition; append ✓ when it succeeds.
  //
  // Examples:
  // "personal": {"icon":"","label":"Personal"},
  // "personal.notes": {"icon":"󰎞","label":"Notes","action":"omarchy-launch-editor ~/notes"},
  // "personal.files": {"icon":"","label":"Files","action":"uwsm-app -- nautilus ~/Documents"},
  //
  // Only use provider when a provider_name function or command named "name"
  // returns JSON rows. Static submenus only need dotted ids.
  //
  // Example: replace the default About action by reusing the same id. Existing
  // fields are kept unless overridden.
  // "about": {"icon":"","label":"About","action":"omarchy-launch-or-focus-tui \"zsh -c 'fastfetch; read -k 1'\""},
  // Mullet Works: everything built in the Claude sessions on this laptop, in
  // one place (sits last in the Go menu, where About would be). Easter eggs
  // stay out of it on purpose.
  "mullet": {"icon":"󱁤","label":"Mullet Works","description":"Everything Claude built here: hub, tools, builders"},
  "mullet.hub": {"icon":"󰒓","label":"Settings hub","description":"Search and change every setting (SUPER + CTRL + ALT + S)","action":"sleep 0.2; omarchy-shell shell toggle daa.settings"},
  "mullet.search": {"icon":"󰍉","label":"Quick search","description":"Tap SUPER: apps, /commands, calculator, subnets","action":"sleep 0.2; omarchy-shell shell toggle daa.search"},
  "mullet.power": {"icon":"󰐥","label":"Power bar","description":"SUPER + ESC","action":"sleep 0.2; omarchy-shell shell toggle daa.powerbar"},
  "mullet.zap": {"icon":"󰚌","label":"Zap an app","description":"SUPER + SHIFT + Q: click a window to end its whole program","action":"sleep 0.2; omarchy-shell shell summon daa.zap '{}'"},
  "mullet.focus": {"icon":"󰽥","label":"Focus mode","description":"SUPER + CTRL + ALT + F: hide the bar, mute, dim the rest","action":"~/.local/bin/focus-mode"},
  "mullet.dropdowns": {"icon":"󰘔","label":"Dropdown builder","description":"Turn any app into a SUPER-key dropdown","action":"sleep 0.2; omarchy-shell shell summon daa.settings '{\"page\":\"scratchpads\"}'"},
  "mullet.rules": {"icon":"󰖲","label":"Window rules","description":"Opacity, floating size, always on top, workspace","action":"sleep 0.2; omarchy-shell shell summon daa.settings '{\"page\":\"rules\"}'"},
  "mullet.keys": {"icon":"󰌌","label":"Keyboard shortcuts","description":"Rebind anything, with clash warnings","action":"sleep 0.2; omarchy-shell shell summon daa.settings '{\"page\":\"keys\"}'"},
  "mullet.devices": {"icon":"󰒓","label":"Device settings","description":"Panels and settings apps, by category","action":"sleep 0.2; omarchy-shell shell summon daa.settings '{\"page\":\"devices\"}'"},
  "mullet.lab": {"icon":"󰒋","label":"Lab sheet","description":"Lab address, services, Lab API","action":"sleep 0.2; omarchy-shell shell summon daa.settings '{\"page\":\"lab\"}'"},
  "mullet.backups": {"icon":"󰁯","label":"Checkpoints","description":"Save or restore the whole setup","action":"sleep 0.2; omarchy-shell shell summon daa.settings '{\"page\":\"backups\"}'"},
  "mullet.infobar": {"icon":"󰘖","label":"Info bar","description":"Workspaces, clock, weather, status, quote","action":"omarchy-shell daa.infobar toggle"},
  "mullet.map": {"icon":"󰈙","label":"Desktop map","description":"What triggers what (regenerated each time)","action":"config-map && uwsm-app -- xdg-open ~/Documents/desktop-map.md"},
  "mullet.ideas": {"icon":"󰛨","label":"Ideas list","description":"The running ideas backlog","action":"uwsm-app -- xdg-open ~/Documents/desktop-ideas.md"},
