#!/usr/bin/env python3
"""Helper for the Keys menu (Desktop settings → Keys, daa.settings).

  keys-tool list            every binding (from the registry in
                            hypr/keys_registry.lua) as JSON:
                            [{"keys", "description", "from"}] where "from" is
                            the original keys when the menu moved it
  keys-tool write '<json>'  save the changes ([{"from","to","description"}] or
                            {"from","disable":true}), regenerate
                            hypr/keys_user.lua and reload Hyprland. If the
                            reload reports errors or loses bindings, the
                            previous file is put back.
"""
import json, os, subprocess, sys, tempfile, time

HOME = os.path.expanduser("~")
JSON_PATH = f"{HOME}/.config/hypr/keys_user.json"
LUA_PATH = f"{HOME}/.config/hypr/keys_user.lua"


def run(*a):
    return subprocess.run(list(a), capture_output=True, text=True).stdout


def load_overrides():
    try:
        return json.load(open(JSON_PATH))
    except (OSError, ValueError):
        return []


def norm(keys):
    mods, key = [], ""
    for part in str(keys).split("+"):
        p = part.strip().upper()
        if p in ("SUPER", "SHIFT", "CTRL", "CONTROL", "ALT"):
            mods.append("CTRL" if p == "CONTROL" else p)
        elif p:
            key = p
    return "+".join(sorted(mods) + [key])


def list_binds():
    fd, path = tempfile.mkstemp(prefix="keys-", suffix=".tsv")
    os.close(fd)
    lua = ('local f = io.open("%s", "w") '
           'for _, b in pairs(daa_binds) do '
           'local d = b.opts and (b.opts.description or b.opts.desc) or "" '
           'f:write(tostring(b.keys) .. "\\t" .. tostring(d):gsub("[\\t\\n]", " ") .. "\\n") end f:close()') % path
    run("hyprctl", "eval", lua)
    time.sleep(0.2)
    rows = []
    moved = {norm(o["to"]): o["from"] for o in load_overrides() if o.get("to")}
    for line in open(path, encoding="utf-8", errors="replace"):
        keys, _, desc = line.rstrip("\n").partition("\t")
        if not keys:
            continue
        rows.append({"keys": keys, "description": desc, "from": moved.get(norm(keys), "")})
    os.unlink(path)
    for o in load_overrides():
        if o.get("disable"):
            rows.append({"keys": "", "description": o.get("description", ""), "from": o["from"], "disabled": True})
    rows.sort(key=lambda r: (r["description"] == "", r["description"].lower(), r["keys"]))
    print(json.dumps(rows))


def lua_str(s):
    return "[==[" + str(s).replace("]==]", "") + "]==]"


def bind_count():
    try:
        return len(json.loads(run("hyprctl", "binds", "-j")))
    except ValueError:
        return 0


def write(given):
    items = json.loads(given)
    old_json = open(JSON_PATH).read() if os.path.exists(JSON_PATH) else "[]\n"
    old_lua = open(LUA_PATH).read() if os.path.exists(LUA_PATH) else "return {}\n"
    before = bind_count()
    lines = ["-- Generated by Desktop settings → Keys from keys_user.json; not by hand.", "return {"]
    for o in items:
        if not o.get("from"):
            continue
        if o.get("disable"):
            lines.append(f"  {{ from = {lua_str(o['from'])}, disable = true }},")
        elif o.get("to"):
            lines.append(f"  {{ from = {lua_str(o['from'])}, to = {lua_str(o['to'])} }},")
    lines.append("}")
    open(LUA_PATH, "w").write("\n".join(lines) + "\n")
    with open(JSON_PATH, "w") as f:
        json.dump(items, f, indent=2)
        f.write("\n")
    run("hyprctl", "reload")
    time.sleep(1.0)
    errs = run("hyprctl", "configerrors").strip()
    after = bind_count()
    disabled = sum(1 for o in items if o.get("disable"))
    # A disabled binding is one fewer; anything worse means something broke.
    if errs or after < before - disabled - 5 or after < 50:
        open(LUA_PATH, "w").write(old_lua)
        open(JSON_PATH, "w").write(old_json)
        run("hyprctl", "reload")
        print(json.dumps({"ok": False, "error": "Hyprland didn't take it (" + (errs or f"{after} bindings left") + "); put back the previous keys."}))
        return
    print(json.dumps({"ok": True, "binds": after}))


cmd = sys.argv[1] if len(sys.argv) > 1 else ""
if cmd == "list":
    list_binds()
elif cmd == "write" and len(sys.argv) > 2:
    write(sys.argv[2])
else:
    print(__doc__)
    sys.exit(1)
