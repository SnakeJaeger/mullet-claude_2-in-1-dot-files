#!/usr/bin/env python3
"""Helper for the scratchpad builder (Desktop settings → Scratchpads, daa.settings).

  scratch-tool detect <command>   launch it, wait for a NEW window, print its
                                  class / title / size as JSON
  scratch-tool window <pid>       class / title / size / command line of the
                                  window owned by <pid> (after a window pick)
  scratch-tool capture <class>    current size + position of that class's
                                  window, relative to its monitor (JSON)
  scratch-tool write [json]       regenerate ~/.config/hypr/dropdowns_user.lua
                                  from dropdowns_user.json and reload Hyprland
  scratch-tool show <name>        show that scratchpad (for testing)
"""
import json, os, subprocess, sys, time

HOME = os.path.expanduser("~")
JSON_PATH = f"{HOME}/.config/hypr/dropdowns_user.json"
LUA_PATH = f"{HOME}/.config/hypr/dropdowns_user.lua"


def hypr(*args):
    return json.loads(subprocess.run(["hyprctl", *args, "-j"], capture_output=True, text=True).stdout or "[]")


def out(obj):
    print(json.dumps(obj))


def cmdline(pid):
    try:
        parts = open(f"/proc/{pid}/cmdline", "rb").read().split(b"\0")
        return " ".join(p.decode(errors="replace") for p in parts if p)
    except OSError:
        return ""


def detect(command):
    before = {c["address"] for c in hypr("clients")}
    subprocess.Popen(["uwsm-app", "--", "bash", "-lc", command], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    deadline = time.time() + 20
    while time.time() < deadline:
        time.sleep(0.4)
        for c in hypr("clients"):
            if c["address"] not in before and c.get("mapped"):
                return out({"ok": True, "class": c["class"], "title": c["title"],
                            "w": c["size"][0], "h": c["size"][1], "pid": c["pid"]})
    out({"ok": False, "error": "No new window appeared within 20 s. If the app was already open, "
                               "it may have reused its old window: close it and try again, or use Pick a window."})


def window(pid):
    for c in hypr("clients"):
        if str(c["pid"]) == str(pid):
            return out({"ok": True, "class": c["class"], "title": c["title"], "w": c["size"][0],
                        "h": c["size"][1], "pid": c["pid"], "cmd": cmdline(c["pid"])})
    out({"ok": False, "error": "That window is gone."})


def capture(cls):
    mons = {m["id"]: m for m in hypr("monitors")}
    best = None
    for c in hypr("clients"):
        if c["class"] != cls or not c.get("mapped"):
            continue
        # Prefer the one on a dropdown's special workspace.
        if best is None or c["workspace"]["name"].startswith("special:dropdown-"):
            best = c
    if not best:
        return out({"ok": False, "error": f"No {cls} window is open. Open it (Test) first."})
    m = mons.get(best["monitor"], {"x": 0, "y": 0, "width": 0, "height": 0, "scale": 1})
    mw = round(m["width"] / m["scale"])
    x = best["at"][0] - m["x"]
    y = best["at"][1] - m["y"]
    w, h = best["size"]
    out({"ok": True, "w": w, "h": h, "x": x, "y": y, "right": mw - x - w})


def lua_str(s):
    return "[==[" + str(s).replace("]==]", "") + "]==]"


def write(given=None):
    # The builder passes the list itself (saving it here avoids racing its
    # own file write); without one, regenerate from the saved JSON.
    if given:
        items = json.loads(given)
        with open(JSON_PATH, "w") as f:
            json.dump(items, f, indent=2)
            f.write("\n")
    else:
        try:
            items = json.load(open(JSON_PATH))
        except (OSError, ValueError):
            items = []
    lines = ["-- Generated by the scratchpad builder (Desktop settings → Scratchpads)",
             "-- from dropdowns_user.json. Edit there, or in the builder; not by hand.", "return {"]
    for d in items:
        if not d.get("name") or not d.get("cmd") or not d.get("match"):
            continue
        f = [f"name = {lua_str(d['name'])}", f"title = {lua_str(d.get('title') or 'Dropdown ' + d['name'])}",
             f"cmd = {lua_str(d['cmd'])}", f"match = {lua_str(d['match'])}"]
        if d.get("key"):
            f.append(f"key = {lua_str(d['key'])}")
        if d.get("w") and d.get("h"):
            f.append(f"px = {{ {int(d['w'])}, {int(d['h'])} }}")
        pos = d.get("position", "center")
        if pos == "right":
            f.append(f"right = {int(d.get('margin', 10))}")
        elif pos == "custom" and d.get("x") is not None:
            f.append(f"x = {int(d['x'])}")
        if d.get("y") is not None and d.get("slide") != "bottom":
            f.append(f"y = {int(d['y'])}")
        slide = d.get("slide", "top")
        if slide == "right":
            f.append('slide = "slide"')
        elif slide == "left":
            f.append('slide = "slide left"')
        elif slide == "fade":
            f.append('slide = "fade"')
        elif slide == "bottom":
            f.append(f"rise = {float(d.get('rise', 1 / 3)):.3f}")
        if d.get("preload"):
            f.append("preload = true")
        if d.get("quitOnHide"):
            f.append("quit_on_hide = true")
        lines.append("  { " + ", ".join(f) + " },")
    lines.append("}")
    open(LUA_PATH, "w").write("\n".join(lines) + "\n")
    subprocess.run(["hyprctl", "reload"], capture_output=True)
    errs = subprocess.run(["hyprctl", "configerrors"], capture_output=True, text=True).stdout.strip()
    out({"ok": not errs, "errors": errs})


def show(name):
    subprocess.run(["hyprctl", "eval", f'dropdown_show("{name}")'], capture_output=True)
    out({"ok": True})


cmd = sys.argv[1] if len(sys.argv) > 1 else ""
arg = " ".join(sys.argv[2:])
if cmd == "detect" and arg:
    detect(arg)
elif cmd == "window" and arg:
    window(arg)
elif cmd == "capture" and arg:
    capture(arg)
elif cmd == "write":
    write(arg or None)
elif cmd == "show" and arg and arg.replace("-", "").replace("_", "").isalnum():
    show(arg)
else:
    print(__doc__)
    sys.exit(1)
