#!/usr/bin/env python3
"""Login screen (SDDM) for Desktop settings → Login (daa.settings).

  sddm-tool list                       JSON {themes:[…], current, avatar}
  sddm-tool preview <theme>            open the theme in a test window (no root)
  sddm-tool theme <theme>              make it the login theme            (root)
  sddm-tool background <theme> <img>   that theme's background picture   (root)
  sddm-tool avatar <img>               your picture on the login screen  (root)

Root changes go through `pkexec ~/.local/bin/sddm-apply`, which asks for the
password with the polkit dialog and only accepts these three changes.
"""
import configparser, glob, json, os, re, subprocess, sys

HOME = os.path.expanduser("~")
THEMES = "/usr/share/sddm/themes"
USER = os.environ.get("USER", "")
APPLY = f"{HOME}/.local/bin/sddm-apply"


def meta(d):
    cp = configparser.ConfigParser(interpolation=None, strict=False)
    try:
        cp.read(f"{d}/metadata.desktop")
        sec = cp["SddmGreeterTheme"] if cp.has_section("SddmGreeterTheme") else {}
        return dict(sec)
    except configparser.Error:
        return {}


def background(d):
    for f in ("theme.conf.user", "theme.conf"):
        m = re.search(r"(?mi)^background\s*=\s*(.+)$", open(f"{d}/{f}").read()) if os.path.exists(f"{d}/{f}") else None
        if m:
            p = m.group(1).strip().strip('"')
            return p if p.startswith("/") else f"{d}/{p}"
    return ""


def current():
    # The last [Theme] Current= wins, in sddm.conf.d file order.
    cur = ""
    for f in sorted(glob.glob("/etc/sddm.conf.d/*.conf")) + ["/etc/sddm.conf"]:
        try:
            text = open(f).read()
        except OSError:
            continue
        for sec in re.split(r"(?m)^\[", text):
            if sec.startswith("Theme]"):
                m = re.search(r"(?m)^Current\s*=\s*(\S+)", sec)
                if m:
                    cur = m.group(1)
    return cur


def themes():
    out = []
    for d in sorted(glob.glob(f"{THEMES}/*/")):
        d = d.rstrip("/")
        m = meta(d)
        shot = m.get("screenshot", "")
        out.append({"id": os.path.basename(d), "name": m.get("name", os.path.basename(d)),
                    "screenshot": f"{d}/{shot}" if shot and os.path.exists(f"{d}/{shot}") else "",
                    "background": background(d) if os.path.exists(background(d) or "/nonexistent") else ""})
    return out


def valid_theme(t):
    return re.fullmatch(r"[\w.-]+", t or "") and os.path.isdir(f"{THEMES}/{t}")


def valid_image(p):
    return os.path.isfile(p) and p.lower().endswith((".png", ".jpg", ".jpeg", ".webp"))


cmd, args = (sys.argv[1] if len(sys.argv) > 1 else ""), sys.argv[2:]
if cmd == "list":
    av = f"/var/lib/AccountsService/icons/{USER}"
    print(json.dumps({"themes": themes(), "current": current(), "avatar": av if os.path.exists(av) else ""}))
elif cmd == "preview" and args and valid_theme(args[0]):
    subprocess.Popen(["uwsm-app", "--", "sddm-greeter-qt6", "--test-mode", "--theme", f"{THEMES}/{args[0]}"],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    print(json.dumps({"ok": True}))
elif cmd in ("theme", "background", "avatar") and args:
    if cmd != "avatar" and not valid_theme(args[0]):
        sys.exit(print(json.dumps({"ok": False, "error": "No such theme."})))
    img = os.path.realpath(args[-1]) if cmd != "theme" else ""
    if img and not valid_image(img):
        sys.exit(print(json.dumps({"ok": False, "error": "Pick a PNG, JPEG or WebP picture."})))
    argv = {"theme": [args[0]], "background": [args[0], img], "avatar": [USER, img]}[cmd]
    r = subprocess.run(["pkexec", APPLY, cmd] + argv, capture_output=True, text=True)
    print(json.dumps({"ok": r.returncode == 0, "error": (r.stderr.strip() or "Cancelled.")[-200:] if r.returncode else ""}))
else:
    print(__doc__)
    sys.exit(1)
