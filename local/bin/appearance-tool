#!/usr/bin/env python3
"""Icon and cursor themes for Desktop settings → Look (daa.settings).

  appearance-tool list                 JSON {icons:[…], cursors:[…], current…}
  appearance-tool icons <name>|theme   set the icon theme everywhere ("theme"
                                       = follow the Omarchy theme again)
  appearance-tool cursor <name> <size> set the cursor theme + size live and
                                       for the next login

Choices are kept in ~/.config/omarchy/appearance.json; the theme-set hook
zz-daa-appearance re-applies an icon choice after a theme change.
"""
import configparser, glob, json, os, re, subprocess, sys

HOME = os.path.expanduser("~")
STATE = f"{HOME}/.config/omarchy/appearance.json"
CURSOR_LUA = f"{HOME}/.config/hypr/cursor_user.lua"
THEME_ICONS = f"{HOME}/.local/state/omarchy/current/theme/icons.theme"
DIRS = ["/usr/share/icons", f"{HOME}/.local/share/icons", f"{HOME}/.icons"]
HIDDEN = {"default", "hicolor", "Omarchy-Qt", "AdwaitaLegacy", "HighContrast"}


def run(*a):
    return subprocess.run(list(a), capture_output=True, text=True).stdout.strip()


def load():
    try:
        return json.load(open(STATE))
    except (OSError, ValueError):
        return {}


def save(d):
    with open(STATE, "w") as f:
        json.dump(d, f, indent=2)
        f.write("\n")


def themes():
    icons, cursors = {}, {}
    for d in DIRS:
        for p in sorted(glob.glob(d + "/*/")):
            name = os.path.basename(p.rstrip("/"))
            if name in HIDDEN:
                continue
            idx = p + "index.theme"
            label = name
            if os.path.exists(idx):
                cp = configparser.ConfigParser(interpolation=None, strict=False)
                try:
                    cp.read(idx)
                    label = cp.get("Icon Theme", "Name", fallback=name)
                    if cp.has_option("Icon Theme", "Directories"):
                        icons[name] = label
                except configparser.Error:
                    pass
            if os.path.isdir(p + "cursors"):
                cursors[name] = label
    return icons, cursors


def gs(key):
    return run("gsettings", "get", "org.gnome.desktop.interface", key).strip("'")


def theme_icons():
    try:
        return open(THEME_ICONS).read().strip()
    except OSError:
        return ""


def set_icons(name):
    d = load()
    if name == "theme":
        d.pop("icons", None)
        name = theme_icons() or "Yaru-blue"
    else:
        d["icons"] = name
    save(d)
    run("gsettings", "set", "org.gnome.desktop.interface", "icon-theme", name)
    # Qt (qt6ct → Omarchy-Qt) inherits from the chosen theme.
    qt = f"{HOME}/.local/share/icons/Omarchy-Qt/index.theme"
    if os.path.exists(qt):
        text = open(qt).read()
        text = re.sub(r"(?m)^Inherits=[^,\n]*", f"Inherits={name}", text, count=1)
        open(qt, "w").write(text)


def set_cursor(name, size):
    size = max(16, min(96, int(size)))
    d = load()
    d["cursor"], d["cursorSize"] = name, size
    save(d)
    run("hyprctl", "setcursor", name, str(size))
    run("gsettings", "set", "org.gnome.desktop.interface", "cursor-theme", name)
    run("gsettings", "set", "org.gnome.desktop.interface", "cursor-size", str(size))
    os.makedirs(f"{HOME}/.icons/default", exist_ok=True)
    open(f"{HOME}/.icons/default/index.theme", "w").write(f"[Icon Theme]\nName=Default\nInherits={name}\n")
    open(CURSOR_LUA, "w").write(
        "-- Generated by Desktop settings → Look (appearance-tool); not by hand.\n"
        f'hl.env("XCURSOR_THEME", "{name}")\nhl.env("HYPRCURSOR_THEME", "{name}")\n'
        f'hl.env("XCURSOR_SIZE", "{size}")\nhl.env("HYPRCURSOR_SIZE", "{size}")\n')


cmd, args = (sys.argv[1] if len(sys.argv) > 1 else ""), sys.argv[2:]
if cmd == "list":
    icons, cursors = themes()
    d = load()
    print(json.dumps({"icons": [{"id": k, "name": v} for k, v in sorted(icons.items(), key=lambda x: x[1].lower())],
                      "cursors": [{"id": k, "name": v} for k, v in sorted(cursors.items(), key=lambda x: x[1].lower())],
                      "icon": gs("icon-theme"), "iconFollowsTheme": "icons" not in d, "themeIcons": theme_icons(),
                      "cursor": gs("cursor-theme"), "cursorSize": int(gs("cursor-size") or 24)}))
elif cmd == "icons" and args and (args[0] == "theme" or re.fullmatch(r"[\w.+-]+", args[0])):
    set_icons(args[0])
    print(json.dumps({"ok": True}))
elif cmd == "cursor" and len(args) == 2 and re.fullmatch(r"[\w.+-]+", args[0]) and args[1].isdigit():
    set_cursor(args[0], args[1])
    print(json.dumps({"ok": True}))
elif cmd == "reapply":
    d = load()
    if d.get("icons"):
        set_icons(d["icons"])
else:
    print(__doc__)
    sys.exit(1)
