#!/usr/bin/env python3
"""Helper for Desktop settings → Rules (daa.settings/WindowRules.qml).

  rules-tool write '<json>'   save the rules ([{class, opacity, float, w, h,
                              center, pin, workspace}]), regenerate
                              hypr/windowrules_user.lua and reload Hyprland;
                              put the old file back if Hyprland reports errors
  rules-tool classes          classes of the open windows (JSON)
"""
import json, os, re, subprocess, sys, time

HOME = os.path.expanduser("~")
JSON_PATH = f"{HOME}/.config/hypr/windowrules_user.json"
LUA_PATH = f"{HOME}/.config/hypr/windowrules_user.lua"


def run(*a):
    return subprocess.run(list(a), capture_output=True, text=True).stdout


def lua_str(s):
    return "[==[" + str(s).replace("]==]", "") + "]==]"


def write(given):
    items = json.loads(given)
    old_json = open(JSON_PATH).read() if os.path.exists(JSON_PATH) else "[]\n"
    old_lua = open(LUA_PATH).read() if os.path.exists(LUA_PATH) else "return {}\n"
    lines = ["-- Generated by Desktop settings → Rules from windowrules_user.json; not by hand.", "return {"]
    for r in items:
        cls = str(r.get("class", "")).strip()
        if not cls:
            continue
        f = [f"match = {{ class = {lua_str('^(' + re.escape(cls) + ')$')} }}"]
        op = r.get("opacity")
        if op is not None and float(op) < 1:
            f += ['tag = "-default-opacity"', f'opacity = "{float(op):.2f} {float(op):.2f}"']
        if r.get("float"):
            f.append("float = true")
            if r.get("w") and r.get("h"):
                f.append(f"size = {{ {int(r['w'])}, {int(r['h'])} }}")
            if r.get("center", True):
                f.append("center = true")
        if r.get("pin"):
            f += ["float = true", "pin = true"] if not r.get("float") else ["pin = true"]
        ws = str(r.get("workspace") or "")
        if ws.isdigit():
            f.append(f'workspace = "{ws} silent"' if r.get("silent") else f'workspace = "{ws}"')
        lines.append("  { " + ", ".join(f) + " },")
    lines.append("}")
    open(LUA_PATH, "w").write("\n".join(lines) + "\n")
    with open(JSON_PATH, "w") as fh:
        json.dump(items, fh, indent=2)
        fh.write("\n")
    run("hyprctl", "reload")
    time.sleep(0.8)
    errs = run("hyprctl", "configerrors").strip()
    if errs:
        open(LUA_PATH, "w").write(old_lua)
        open(JSON_PATH, "w").write(old_json)
        run("hyprctl", "reload")
        print(json.dumps({"ok": False, "error": "Hyprland didn't take it (" + errs[:200] + "); put back the previous rules."}))
        return
    print(json.dumps({"ok": True}))


def classes():
    seen = []
    for c in json.loads(run("hyprctl", "clients", "-j") or "[]"):
        if c.get("class") and c["class"] not in seen and not c["workspace"]["name"].startswith("special:"):
            seen.append(c["class"])
    print(json.dumps(seen))


cmd = sys.argv[1] if len(sys.argv) > 1 else ""
if cmd == "write" and len(sys.argv) > 2:
    write(sys.argv[2])
elif cmd == "classes":
    classes()
else:
    print(__doc__)
    sys.exit(1)
